# Railway Environment Variables
# Copy these to Railway dashboard → Service → Variables

# ============================================
# BACKEND SERVICE VARIABLES
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
USE_FAKE_AI=0
# PORT is automatically set by Railway

# ============================================
# FRONTEND SERVICE VARIABLES
# ============================================
NEXT_PUBLIC_API_BASE_URL=https://your-backend-service.up.railway.app
# PORT is automatically set by Railway

# ============================================
# NOTES
# ============================================
# 1. Replace 'your-backend-service.up.railway.app' with your actual backend URL
# 2. Get backend URL from: Railway Dashboard → Backend Service → Settings → Networking → Public Domain
# 3. After setting NEXT_PUBLIC_API_BASE_URL, Railway will automatically rebuild the frontend

